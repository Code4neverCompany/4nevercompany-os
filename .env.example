# 4neverCompany OS Environment Variables

# App Configuration
NEXT_PUBLIC_APP_NAME="4neverCompany OS"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Server Configuration
PORT=3000
NODE_ENV=development

# GitHub Integration
GITHUB_TOKEN=your_github_pat_here
GITHUB_ORG=Code4neverCompany

# WebSocket Configuration
WS_PORT=3001
WS_PATH=/bridge

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL="file:./data/os.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/os"

# Hermes WSL2 Bridge
HERMES_WSL_HOST=localhost
HERMES_WSL_PORT=2222
HERMES_WSL_USER=your_user
HERMES_WSL_KEY_PATH=~/.ssh/hermes_key

# Memory Vault
VAULT_PATH=./vault
VAULT_SYNC_INTERVAL=5000

# MCP Configuration
MCP_SERVER_PORT=3002
MCP_TRANSPORT=stdio

# Vercel (for deployment)
VERCEL_URL=https://4nevercompany-os.vercel.app
VERCEL_TOKEN=your_vercel_token

# Claude API (for agent spawning)
CLAUDE_API_KEY=your_claude_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# MiniMax API
MINIMAX_API_KEY=your_minimax_key

# Brand Colors (for theming)
GOLD_COLOR=#C5A059
CYAN_COLOR=#00FFFF

# Feature Flags
ENABLE_HERMES_LINK=true
ENABLE_CLAUDE_SPAWN=true
ENABLE_MAVIS_INTEGRATION=true
ENABLE_SELF_BUILD=false